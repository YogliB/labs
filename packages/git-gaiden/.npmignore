# .npmignore for git-gaiden

# Source code (built version goes to dist/)
src/

# Tests
**/*.test.ts
**/*.spec.ts
vitest.config.ts

# Build configuration
tsconfig.json
tsdown.config.ts

# Development files
.gitignore
.npmignore

# Documentation (will be in README.md)
docs/

# CI/CD
.github/

# Development dependencies and tools
node_modules/
*.log
.DS_Store

# Coverage reports
coverage/
.nyc_output/

# Local development state
.git-gaiden.json
~/.git-gaiden/
