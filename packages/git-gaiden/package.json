{
	"name": "git-gaiden",
	"version": "0.1.0",
	"description": "Turn Git history into choose-your-own-adventure games",
	"main": "dist/index.js",
	"bin": {
		"gaiden": "dist/cli.js"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"keywords": [
		"git",
		"game",
		"cli",
		"adventure"
	],
	"author": "YogliB",
	"license": "MIT",
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"@xenova/transformers": "2.17.2",
		"ink": "^5.0.1",
		"meow": "^13.2.0",
		"react": "^18.3.1",
		"simple-git": "^3.27.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/react": "^18.3.0",
		"@vitest/coverage-v8": "^2.0.0",
		"@vitest/ui": "^2.0.0",
		"tsdown": "^0.3.0",
		"typescript": "^5.7.0",
		"vitest": "^2.0.0"
	}
}
